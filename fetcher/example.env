# Settings for the fetcher (fetcher/main.mjs --env <this file>). Copy it outside the project, fill it in, and keep it
# private (on Linux: chmod 600). Never commit the filled-in copy.

# Trafikverket's key (data.trafikverket.se).
TRV_KEY=

# one.com upload (only with --upload). The password is the SFTP one (one.com: Hostinginställningar -> FTP ->
# SFTP-administration, set by an e-mailed link), not the control panel's.
SFTP_HOST=ssh.example.service.one
SFTP_PORT=22
SFTP_USER=example_ssh
SFTP_PASS=
# The folder the files go to (its own folder: everything ours in it may be deleted by the fetcher).
SFTP_DIR=/webroots/xxxxxxxx/data
# The server's key fingerprints (ssh-keyscan the host, then ssh-keygen -lf), comma-separated, without "SHA256:".
SFTP_HOSTKEY=
