# Settings for the monitor (monitor/main.mjs --env <this file>). Copy it outside the project, fill it in, keep it private
# (on Linux: /etc/sparat/monitor.env, chmod 600, owned by the sparat user). Never commit the filled-in copy.

# Where viewers read the fetcher's files (the folder on one.com with live-....json in it), ending in /.
MONITOR_DATA_URL=https://example.rangner.com/sparat/data/

# Mail: a Gmail used only for this (2-step verification on, then an app password; the app password goes here, not the
# account's own password). Gmail's server below is to be confirmed at install. Leave all MAIL_ lines empty for no mails.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
# Who gets the mails.
MAIL_TO=

# Rarely changed (these are the defaults):
# MONITOR_FETCHER=http://127.0.0.1:8091/status
# MONITOR_PORT=8092
# MONITOR_SUMMARY_AT=07:00
